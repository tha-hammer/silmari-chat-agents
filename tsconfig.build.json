{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "outDir": "./dist/types",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "tsc-alias": {
    "replacers": {
      "declaration-imports": {
        "enabled": true,
        "file": "./config/declaration-import-replacer.cjs"
      }
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "node_modules",
    "dist",
    "src/proto/**/*",
    "src/scripts/**/*",
    "src/specs/**/*"
  ]
}
